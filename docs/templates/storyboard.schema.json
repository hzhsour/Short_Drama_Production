{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short Drama Storyboard",
  "type": "object",
  "required": ["episode_id", "aspect_ratio", "fps", "shots"],
  "properties": {
    "episode_id": { "type": "string", "pattern": "^EP\\d{3}$" },
    "aspect_ratio": { "type": "string", "default": "9:16" },
    "fps": { "type": "integer", "minimum": 1 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id", "scene_id", "duration_frames", "characters", "location",
          "action", "framing", "camera_move", "dialogue", "audio",
          "image_prompt", "video_prompt", "continuity_refs"
        ],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^EP\\d{3}-SC\\d{2}-SH\\d{2,3}$" },
          "scene_id": { "type": "string" },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "characters": { "type": "array", "items": { "type": "string" } },
          "location": { "type": "string" },
          "action": { "type": "string" },
          "framing": { "type": "string" },
          "camera_move": { "type": "string" },
          "dialogue": { "type": "array" },
          "audio": { "type": "array" },
          "image_prompt": { "type": "string" },
          "video_prompt": { "type": "string" },
          "continuity_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
